rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdministrador() {
      return request.auth != null
        && request.auth.token.email == 'contactoszubi@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Solo las colecciones del directorio: lectura pública, escritura solo del administrador
    match /hospitales/{id} { allow read: if true; allow create, update, delete: if esAdministrador(); }
    match /servicios/{id}  { allow read: if true; allow create, update, delete: if esAdministrador(); }
    match /contactos/{id}  { allow read: if true; allow create, update, delete: if esAdministrador(); }
    match /config/{id}     { allow read: if true; allow create, update, delete: if esAdministrador(); }
  }
}
